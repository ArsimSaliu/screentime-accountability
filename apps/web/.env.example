# Copy to .env.local. Values from Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# For universal links (invite links open the iOS app): <Apple Team ID>.<bundle id>
APPLE_APP_ID=ABCDE12345.com.yourname.leash
