# Copy to .env and fill in from Supabase Dashboard -> Project Settings -> API.
# EXPO_PUBLIC_* values are bundled into the app: only use the publishable/anon key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
EXPO_PUBLIC_WEB_URL=https://your-web-app.vercel.app
