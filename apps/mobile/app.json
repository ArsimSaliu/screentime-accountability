{
  "expo": {
    "name": "Leash",
    "slug": "screentime-accountability",
    "scheme": "leash",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.yourname.leash",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "YOUR_APPLE_TEAM_ID"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "react-native-device-activity",
        {
          "appleTeamId": "YOUR_APPLE_TEAM_ID",
          "appGroup": "group.com.yourname.leash"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {}
    }
  }
}
